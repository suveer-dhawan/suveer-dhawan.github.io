<style>
  /* Ensure the main container doesn't get squeezed by the theme's sidebars */
  #core-wrapper {
    overflow: visible !important;
  }

  .timeline-wrapper {
    position: relative;
    max-width: 800px; /* Constrain width to keep nodes close to spine */
    margin: 4rem auto;
    padding: 0;
    list-style: none;
  }

  /* Explicitly color the Spine */
  .timeline-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px; /* Slightly thicker for visibility */
    background: var(--theme-color);
    left: 50%;
    transform: translateX(-50%);
    z-index: 0;
    box-shadow: 0 0 15px var(--theme-color); /* Add a glow to the spine itself */
  }

  .timeline-item {
    position: relative;
    width: 50%;
    margin-bottom: 50px;
    z-index: 1;
  }

  .left {
    left: 0;
    padding-right: 40px;
    text-align: right; /* Align text toward the spine */
  }

  .right {
    left: 50%;
    padding-left: 40px;
    text-align: left; /* Align text toward the spine */
  }

  /* Node Dots */
  .timeline-item::after {
    content: '';
    position: absolute;
    width: 20px;
    height: 20px;
    background: var(--card-bg);
    border: 4px solid var(--theme-color);
    border-radius: 50%;
    top: 20px;
    z-index: 2;
    box-shadow: 0 0 10px var(--theme-color);
  }

  .left::after { right: -10px; }
  .right::after { left: -10px; }

  /* Card Glow Improvements */
  .content-box {
    display: inline-block; /* Prevent card from taking full 50% width if text is short */
    max-width: 100%;
    padding: 1.5rem;
    background: var(--card-bg);
    border-radius: 12px;
    border: 1px solid rgba(128, 128, 128, 0.2);
    text-align: left; /* Keep internal text left-aligned */
  }
</style>

