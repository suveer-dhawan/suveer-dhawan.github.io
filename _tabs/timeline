<style>
  /* --- Timeline Logic --- */
  .timeline-wrapper {
    position: relative;
    max-width: 1000px;
    margin: 2rem auto;
    padding: 0 20px;
  }

  /* The Central Spine */
  .timeline-wrapper::after {
    content: '';
    position: absolute;
    width: 2px;
    background: var(--theme-color);
    top: 0;
    bottom: 0;
    left: 50%;
    margin-left: -1px;
    opacity: 0.3;
  }

  /* Container for each event */
  .timeline-item {
    padding: 10px 40px;
    position: relative;
    background-color: inherit;
    width: 50%;
  }

  /* The Node (Dots) */
  .timeline-item::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    right: -8px;
    background-color: var(--card-bg);
    border: 3px solid var(--theme-color);
    top: 24px;
    border-radius: 50%;
    z-index: 1;
    box-shadow: 0 0 10px var(--theme-color);
  }

  /* Positioning Left & Right */
  .left { left: 0; }
  .right { left: 50%; }

  .right::after { left: -8px; }

  /* Card Styling */
  .content-box {
    padding: 1.5rem;
    background: var(--card-bg);
    position: relative;
    border-radius: 12px;
    border: 1px solid rgba(128, 128, 128, 0.1);
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  }

  .timeline-item:hover .content-box {
    transform: translateY(-5px);
    border-color: var(--theme-color);
    box-shadow: 0 10px 25px rgba(66, 133, 244, 0.15); /* Monash Blue / NYU Purple glow */
  }

  .exp-title { font-size: 1.2rem; font-weight: bold; margin-bottom: 5px; color: var(--text-color); }
  .exp-meta { font-size: 0.85rem; color: var(--theme-color); font-weight: 600; margin-bottom: 10px; text-transform: uppercase; }
  .exp-desc { font-size: 0.95rem; line-height: 1.5; color: var(--text-muted-color); }

  /* Mobile Responsiveness */
  @media screen and (max-width: 768px) {
    .timeline-wrapper::after { left: 31px; }
    .timeline-item { width: 100%; padding-left: 70px; padding-right: 25px; }
    .timeline-item::after { left: 23px !important; }
    .right { left: 0%; }
  }
</style>

