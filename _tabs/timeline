<style>
  /* Force the container to be full width within the page layout */
  .page-content { overflow: visible !important; }

  .timeline-wrapper {
    position: relative;
    max-width: 900px;
    margin: 3rem auto;
    padding: 2rem 0;
  }

  /* The Spine - Explicitly colored and centered */
  .timeline-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--theme-color);
    left: 50%;
    transform: translateX(-50%);
    z-index: 0;
    box-shadow: 0 0 10px var(--theme-color);
    opacity: 0.6;
  }

  .timeline-item {
    position: relative;
    width: 50%;
    margin-bottom: 40px;
    z-index: 1;
  }

  /* Side Alignment Logic */
  .left { left: 0; padding-right: 50px; text-align: right; }
  .right { left: 50%; padding-left: 50px; text-align: left; }

  /* Node Dots - Glowing and centered on the spine */
  .timeline-item::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    background: var(--main-bg);
    border: 3px solid var(--theme-color);
    border-radius: 50%;
    top: 20px;
    z-index: 2;
    box-shadow: 0 0 8px var(--theme-color);
  }

  .left::after { right: -9px; }
  .right::after { left: -9px; }

  /* Content Boxes */
  .content-box {
    display: inline-block;
    padding: 1.2rem 1.5rem;
    background: var(--card-bg);
    border-radius: 12px;
    border: 1px solid rgba(128, 128, 128, 0.15);
    text-align: left;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    width: 100%;
    max-width: 400px;
  }

  .timeline-item:hover .content-box {
    transform: translateY(-5px);
    border-color: var(--theme-color);
    box-shadow: 0 8px 20px rgba(66, 133, 244, 0.2);
  }

  .exp-meta { font-size: 0.8rem; color: var(--theme-color); font-weight: 700; margin-bottom: 5px; }
  .exp-title { font-size: 1.15rem; font-weight: 800; color: var(--text-color); margin-bottom: 4px; }
  .exp-location { font-size: 0.9rem; color: var(--text-muted-color); font-style: italic; }

  /* Responsive Fix for Mobile */
  @media (max-width: 768px) {
    .timeline-wrapper::before { left: 20px; }
    .timeline-item { width: 100%; text-align: left; padding-left: 45px; padding-right: 0; left: 0; }
    .timeline-item::after { left: 11px !important; }
    .content-box { max-width: 100%; }
  }
</style>

